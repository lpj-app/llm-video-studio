{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "product": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "brand": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "theme": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "set": {
      "default": "gradient",
      "type": "string",
      "enum": [
        "gradient"
      ]
    },
    "formats": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "9x16",
          "4x5",
          "1x1",
          "16x9"
        ]
      }
    },
    "langs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "scenes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "hook"
              },
              "text": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                ]
              },
              "seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "type",
              "text"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "feature"
              },
              "feature": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "title": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                ]
              },
              "subtitle": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                ]
              },
              "highlight": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "size": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              "seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "type",
              "feature"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "cta"
              },
              "phase": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "text": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                ]
              },
              "sub": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  ]
                }
              },
              "seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "product",
    "brand",
    "set",
    "formats",
    "scenes"
  ],
  "additionalProperties": false
}
